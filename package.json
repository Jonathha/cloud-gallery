{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cloud-gallery",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@google/genai": "^1.29.0",
    "@jsquash/avif": "^2.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "browser-image-compression": "^2.0.2",
    "detectincognitojs": "^1.7.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.7.0",
    "googleapis": "^173.0.0",
    "idb": "^8.0.3",
    "jose": "^6.2.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.36.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "react-google-recaptcha": "^3.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/ws": "^8.18.1",
    "wrangler": "^4.110.0"
  }
}
